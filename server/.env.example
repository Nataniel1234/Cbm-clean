# --- Servidor -------------------------------------------------
NODE_ENV=development
PORT=4000
# Origens autorizadas (separadas por virgula)
CORS_ORIGIN=http://localhost:5173,http://localhost:8080

# --- Base de dados (PostgreSQL) -------------------------------
DATABASE_URL="postgresql://cbm:cbm@localhost:5432/cbmclean?schema=public"

# --- Notificacoes por email (opcional) ------------------------
# Se MAIL_HOST estiver vazio, os pedidos sao apenas gravados na base de dados.
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM="CBM Clean <no-reply@cbmclean.pt>"
MAIL_TO=geral@cbmclean.pt

# --- Limites --------------------------------------------------
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=20
